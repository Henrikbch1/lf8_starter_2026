
### T002 - Request an access token

# Requests a JWT token from the local Mock OAuth2 Server.
# Run this request first to authenticate subsequent requests.
POST http://localhost:9000/default/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=test-client&client_secret=test-secret

# Extracts the access token from the response and stores it globally.
# The "jwtToken" variable can be reused in other HTTP requests.
> {%
    client.global.set("jwtToken", response.body.access_token);
%}


### T002 - Get all projects (authenticated)

# Retrieves all projects using the globally stored JWT token.
# Expected: 200 OK with a JSON list of projects or [] if empty.
GET http://localhost:8080/projects
Accept: application/json
Authorization: Bearer {{jwtToken}}


### T002 - Get all projects (without authentication)

# Verifies that the endpoint is protected by Spring Security.
# Expected: 401 Unauthorized because no JWT token is provided.
GET http://localhost:8080/projects
Accept: application/json


### T001 - Create a project (valid request)

# Expected: 201 Created with the stored project and a Location header.
POST http://localhost:8080/projects
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "designation": "Rollout Nordlicht",
  "responsibleEmployeeId": 1,
  "customerId": 42,
  "customerContactName": "Mara Beispiel",
  "goalComment": "Einführung der neuen Plattform am Standort Nord.",
  "startDate": "2026-11-02",
  "plannedEndDate": "2026-12-18",
  "requiredQualificationIds": [1, 2]
}


### T001 - Create a project (invalid period)

# Expected: 422 Unprocessable Content because the start date is after the planned end date.
POST http://localhost:8080/projects
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "designation": "Projekt mit ungültigem Zeitraum",
  "responsibleEmployeeId": 1,
  "customerId": 42,
  "customerContactName": "Mara Beispiel",
  "goalComment": "Negativbeispiel für die Datumsprüfung.",
  "startDate": "2026-12-19",
  "plannedEndDate": "2026-12-18",
  "requiredQualificationIds": [1, 2]
}


### T001 - Create a project (unknown responsible employee)

# Expected: 404 Not Found because employee 999 does not exist.
POST http://localhost:8080/projects
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "designation": "Projekt mit unbekanntem Verantwortlichen",
  "responsibleEmployeeId": 999,
  "customerId": 42,
  "customerContactName": "Mara Beispiel",
  "goalComment": "Negativbeispiel für die Mitarbeiterprüfung.",
  "startDate": "2026-11-02",
  "plannedEndDate": "2026-12-18",
  "requiredQualificationIds": [1, 2]
}


### T001 - Create a project (missing designation)

# Expected: 400 Bad Request because designation must not be blank.
POST http://localhost:8080/projects
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "responsibleEmployeeId": 1,
  "customerId": 42,
  "customerContactName": "Mara Beispiel",
  "goalComment": "Negativbeispiel für die Eingabevalidierung.",
  "startDate": "2026-11-02",
  "plannedEndDate": "2026-12-18",
  "requiredQualificationIds": [1, 2]
}
